{
 "headline": {
  "name": "Bryce Harper",
  "number": "3",
  "summary": "The Eye Carried a Softer Bat",
  "full": "Bryce Harper | 3 | The Eye Carried a Softer Bat",
  "dek": "2026 regular season · 162 G · 693 PA · .269/.380/.485 · 29 HR · .375 wOBA"
 },
 "bullets": [
  {
   "lead": "Still the Phillies' best bat.",
   "text": ".269/.380/.485 with 29 HR, and he appeared in all 162 games. His .375 wOBA led the 10 Phillies with 200+ PA and sits in the 94th percentile of 122 Phillies hitter seasons since 2015."
  },
  {
   "lead": "The eye did the heavy lifting.",
   "text": "A 15.4% walk rate, his best since 2020, drove a .380 OBP. Chase (32.4%) and strikeouts (21.4%) stayed inside his Phillies range, and after the break he took even more pitches just off the plate (edge-take .411 → .446)."
  },
  {
   "lead": "The thump stepped back.",
   "text": "Hard-hit 42.8%, barrels 10.3%, 90th-percentile exit velocity 106.3 mph and a .485 SLG: all his lowest as a Phillie. After the break hard contact fell again (46.2% → 37.4%), and the walks held his OPS level (.862 → .868)."
  },
  {
   "lead": "Lefties were the leak.",
   "text": "Against righties, .997 OPS and 25 HR; against lefties, .657 and 4 HR, his lowest vs-LHP OPS in 12 Statcast seasons. The contact backs the results (xwOBA .314 vs wOBA .299): mostly earned, not bad luck."
  }
 ],
